# ---------------------------------------------------------------------------
# Google — service account con scope `spreadsheets`.
# El Sheet debe estar compartido con GOOGLE_CLIENT_EMAIL como Editor.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_EMAIL=nombre@proyecto.iam.gserviceaccount.com
# Pegar la clave completa entre comillas. En Vercel los saltos de línea viajan
# escapados como \n; el código los convierte de vuelta.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1AbCdEf...

# ---------------------------------------------------------------------------
# Instantes de la boda, en UTC absoluto.
#
# Aquí y no en la pestaña Config: son reglas de negocio. Un dedazo en una celda
# editable no puede abrir ni cerrar el RSVP.
#
# Venezuela es UTC-4, así que 6:00 PM hora local son las 22:00 UTC del mismo día.
# ---------------------------------------------------------------------------
WEDDING_MISA_AT=2026-11-07T22:00:00Z       # sáb 7 nov 2026, 6:00 PM VE
WEDDING_RECEPCION_AT=2026-11-08T00:00:00Z  # sáb 7 nov 2026, 8:00 PM VE
RSVP_CUTOFF_AT=2026-10-31T22:00:00Z        # sáb 31 oct 2026, 6:00 PM VE

# ---------------------------------------------------------------------------
# Solo desarrollo. Fuerza el "ahora" del servidor para poder ver el estado
# congelado sin esperar a octubre de 2026. Se ignora en producción.
# ---------------------------------------------------------------------------
# DEV_NOW_OVERRIDE=2026-11-01T12:00:00Z
